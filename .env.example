# Variables del servidor. NUNCA llegan al navegador: solo las usan las
# funciones de netlify/functions/. En Netlify se definen en
# Site configuration -> Environment variables.

# Clave secreta de Stripe (sk_live_... en produccion, sk_test_... para probar).
STRIPE_SECRET_KEY=

# Cadena larga y aleatoria con la que se firman las licencias. Generala con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Si la cambias, todas las licencias ya emitidas dejan de valer.
LICENCIA_SECRET=

# Opcional: fuerza el dominio del sitio. En Netlify y Vercel se detecta solo.
# SITE_URL=https://presuapp.netlify.app

# Datos fiscales del titular, obligatorios por el articulo 10 de la LSSI.
# Se publican en el aviso legal, la privacidad y las condiciones. Van en el
# entorno y no en el codigo para no dejarlos en el historial de git.
TITULAR_NOMBRE=
TITULAR_NIF=
TITULAR_DOMICILIO=
TITULAR_EMAIL=
