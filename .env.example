# Enlaces de pago de Stripe (Payment Links). Copia este archivo a .env.local
# y pega las URLs que te da el panel de Stripe.
#
# En cada enlace, configura la URL de éxito para que vuelva aquí:
#   https://TU-DOMINIO/?pago=ok&plan=unico
#   https://TU-DOMINIO/?pago=ok&plan=suscripcion
VITE_PAGO_UNICO_URL=
VITE_SUSCRIPCION_URL=
